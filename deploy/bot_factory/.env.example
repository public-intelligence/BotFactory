# Bot Factory — application stack (Server 3). Copy to `.env` and fill in.
# Generate secrets with the commands shown; STRICT formats are noted.
#
#   ENCRYPTION_MASTER_KEY   MUST be base64 of exactly 32 bytes:  openssl rand -base64 32
#   FAKE_SIGNING_KEY        >= 32 chars:                          openssl rand -base64 32

# Private image registry (credentials provided separately: docker login ...)
ACR=crvozimages-h3a3g5dzbkamfpd8.azurecr.io

# --- External SQL Server (Server 1 / Windows) ---
SQL_HOST=192.168.1.10          # SQL server hostname or IP
SQL_PORT=1433
SQL_DB=BotFactory              # created automatically if the login may create databases
SQL_USER=botfactory
SQL_PASSWORD=                   # SQL Authentication password
SQL_ENCRYPT=true
SQL_TRUST_CERT=true            # true if the SQL cert is self-signed

# --- SQL Server in a container instead (docker-compose.sql.yml) ---
# Only for that overlay. With it, everything above is ignored except SQL_DB.
#   docker compose -f docker-compose.stack.yml -f docker-compose.sql.yml up -d
# SQL_SA_PASSWORD=            # 8+ chars, upper + lower + digit/symbol, or SQL exits at boot
# SQL_EDITION=Developer       # Developer = free, NOT licensed for production. Express = free, 10 GB cap.
# COMPOSE_FILE=docker-compose.stack.yml:docker-compose.sql.yml   # so plain `docker compose` uses both

# --- LiveKit (Server 2) ---
LIVEKIT_HOST=192.168.1.20                        # LiveKit host/IP reachable from THIS server (for :7880)
LIVEKIT_PORT=7880
LIVEKIT_PUBLIC_HOST=wss://livekit.example.com    # browser-facing, TLS (matches Server 2's LIVEKIT_DOMAIN)
LIVEKIT_API_KEY=botfactory                       # MUST match Server 2
LIVEKIT_API_SECRET=                               # MUST match Server 2

# --- App secrets (generate fresh) ---
ENCRYPTION_MASTER_KEY=          # openssl rand -base64 32
FAKE_SIGNING_KEY=               # openssl rand -base64 32
AGENT_CALLBACK_SECRET=          # openssl rand -base64 24
PUBLIC_ACCESS_SIGNING_KEY=      # openssl rand -base64 32
KB_SCRAPER_API_KEY=             # openssl rand -base64 24

# --- URLs públicas ---
# El dominio y el certificado NO van aquí: se configuran en nginx/site.inc.
# Estos dos sí, y deben coincidir exactamente con la dirección que usa el
# navegador (incluido https://), o el login redirige mal y las llamadas a la
# API fallan por CORS.
ALLOWED_ORIGINS=https://app.sudominio.com
# Public SPA URL for embeds. On Docker the API also loads the shell via bf-frontend
# when the public hostname does not hairpin back to this host.
PUBLIC_SPA_INDEX_URL=https://app.sudominio.com/index.html

# --- Auth: leave true for the test login. For production set false and fill GOBID_* ---
AUTH_USE_FAKE=true
GOBID_API_URL=
GOBID_AUDIENCE=gobid-users
GOBID_LOGIN_BASE_URL=
GOBID_APP_ID=
GOBID_APP_SECRET=
