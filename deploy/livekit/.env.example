# LiveKit (Servidor 2). Copie a `.env`, luego:
#   docker compose -f docker-compose.livekit.yml up -d
#
# El dominio y el certificado NO van aquí — se configuran en nginx/site.inc.
#
# LIVEKIT_API_KEY    identificador compartido — DEBE coincidir con el .env del Servidor 3
# LIVEKIT_API_SECRET secreto compartido       — DEBE coincidir con el .env del Servidor 3
#                                               (generar con: openssl rand -hex 32)

LIVEKIT_API_KEY=botfactory
LIVEKIT_API_SECRET=change-me-openssl-rand-hex-32
