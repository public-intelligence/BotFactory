# LiveKit worker (self-hosted)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# .NET API base URL (no trailing slash required)
BACKEND_URL=http://localhost:5000

# Must match RoomAgentDispatch when the room is created
AGENT_NAME=bot-factory-agent

# Health probe port (GET /healthz)
HEALTH_PORT=8089

# Optional: DEBUG, INFO, WARNING
LOG_LEVEL=INFO

# Optional AgentServer tuning (prod / start); defaults suit 2 GB / 1 vCPU ACI
# AGENT_NUM_IDLE_PROCESSES=1
# AGENT_JOB_MEMORY_WARN_MB=1600
# AGENT_JOB_MEMORY_LIMIT_MB=1900
# AGENT_LOAD_THRESHOLD=0.8
# AGENT_INITIALIZE_PROCESS_TIMEOUT=60
# One JSON object per line (default). Use text for local readability.
# LOG_FORMAT=json
# LOG_FORMAT=text
