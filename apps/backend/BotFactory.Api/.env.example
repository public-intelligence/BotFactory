# Connection string for SQL Server
ConnectionStrings__BotFactoryDb=Server=localhost,30001;Database=BotFactory;User Id=sa;Password=BotFactory@Pass123!;TrustServerCertificate=true

# CORS: comma-separated list of allowed origins
AllowedOrigins=http://localhost:4200

# Auth: set to false in production to use only GOB-ID
Auth__UseFakeProvider=true

# GOB-ID (used always — get credentials from GOB-ID team)
Auth__GobId__ApiUrl=https://wa-vuc-dev-gobidapi-dqdrgsb8dyggd7df.eastus2-01.azurewebsites.net
Auth__GobId__Audience=gobid-users
Auth__GobId__LoginBaseUrl=https://proud-mud-04a4e750f.4.azurestaticapps.net
Auth__GobId__ApplicationId=<your-application-id>
Auth__GobId__AppSecret=<your-app-secret>

# LiveKit (run `docker compose -f docker-compose.dev.yml up livekit redis` for local dev)
LiveKit__Host=http://localhost:7880
LiveKit__ApiKey=devkey
LiveKit__ApiSecret=secretsecretsecretsecretsecretsecret

# KB scraper (Playwright render service — run `make kb-scraper` or docker compose kb-scraper)
KbScraper__BaseUrl=http://localhost:5080
KbScraper__ApiKey=dev-local-key
KbScraper__TimeoutSeconds=45
KbScraper__Enabled=true

# Public (anonymous) bot access — REQUIRED in production if any bot is public.
# SigningKey: HS256 key (>= 32 chars) for stateless anonymous-session JWTs.
# SpaIndexUrl: where /api/embed/{publicId} fetches the SPA shell from
#   (prod: https://bf.example.com/index.html).
PublicAccess__SigningKey=dev-public-signing-key-at-least-32-chars!!
PublicAccess__SpaIndexUrl=http://localhost:4200/index.html
# PublicAccess__TokenTtlMinutes=15
# PublicAccess__RequestsPerMinutePerIp=30
# PublicAccess__MaxActiveAnonymousConversationsPerBot=20

# Agent callback gate: /livekit/* endpoints reject requests without this secret.
# Must match BACKEND_SHARED_SECRET on the agent. Empty = open (dev only).
AgentCallback__SharedSecret=dev-agent-callback-secret
