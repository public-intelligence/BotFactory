# Copy to .env and fill in secrets:
#   cp .env.production.example .env

# Frontend: GitHub token (read:packages) to install @public-intelligence/ui-core from GitHub Packages
NPM_TOKEN=<your-npm-token>

# GOB-ID credentials (required for GOB-ID auth in docker-compose)
Auth__GobId__ApplicationId=<your-application-id>
Auth__GobId__AppSecret=<your-app-secret>

# Azure Blob Storage connection string (required for KB document storage)
BlobStorage__ConnectionString=DefaultEndpointsProtocol=https;AccountName=<your-account>;AccountKey=<your-key>;EndpointSuffix=core.windows.net
